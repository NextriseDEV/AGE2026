        // --- 5. INTEGRAÇÃO COM BACKEND (GOOGLE APPS SCRIPT) ---
        // Substitua pela URL do seu Web App implantado
        const SCRIPT_URL = 'SUA_URL_DO_WEB_APP_AQUI'; 

        document.getElementById('ministerForm').addEventListener('submit', async function(e){
            e.preventDefault();
            
            // Validações Finais
            if(!document.getElementById('termoAceite').checked) return alert("Você precisa aceitar o termo de comprometimento.");
            if(!document.getElementById('input-foto_credencial').value) return alert("A Foto da Credencial é obrigatória.");

            // Feedback de Carregamento
            const btnSubmit = e.target.querySelector('button[type="submit"]');
            const textoOriginal = btnSubmit.innerHTML;
            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Enviando...';

            // Coleta Dados
            const formData = new FormData(e.target);
            const dados = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(SCRIPT_URL, {
                    method: 'POST',
                    body: JSON.stringify(dados) // Envia como JSON raw
                });
                
                const result = await response.json();

                if (result.result === 'success') {
                    // Sucesso!
                    document.body.innerHTML = `
                        <div class="min-h-screen flex flex-col items-center justify-center bg-green-50 p-6 text-center">
                            <div class="w-24 h-24 bg-green-100 text-green-600 rounded-full flex items-center justify-center text-5xl mb-6 shadow-lg">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <h1 class="text-3xl font-bold text-green-900 mb-2">Inscrição Recebida!</h1>
                            <p class="text-green-800 mb-6">Seus dados foram enviados para análise.<br>ID de Protocolo: <strong>${result.id}</strong></p>
                            <a href="index.html" class="bg-green-600 text-white px-8 py-3 rounded-lg font-bold shadow hover:bg-green-700">Voltar ao Início</a>
                        </div>
                    `;
                } else {
                    throw new Error(result.message);
                }

            } catch (err) {
                alert("Erro ao enviar: " + err.message);
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = textoOriginal;
            }
        });
